{
  "schema_version": 1,
  "catalog_id": "mat-departments",
  "catalog_version": "1.0.0",
  "status": "backend-enforced-sqlite-schema-v2",
  "namespace": "application-local",
  "description": "Controlled application abbreviations, not national or hospital-issued department codes.",
  "code_rules": {
    "width": 8,
    "alphabet": "lowercase ASCII letters followed by zero padding",
    "abbreviation_pattern": "^[a-z]{2,8}$",
    "code_pattern": "^[a-z]{2,8}0{0,6}$",
    "padding": "right-pad the registered abbreviation with ASCII 0 to exactly 8 characters",
    "acceptance": "Exact membership in this catalog is mandatory; matching the pattern alone is insufficient.",
    "immutability": "Published codes are never renamed or reused. Retired entries remain readable.",
    "ai_authority": "AI extracts the documented raw department label and source evidence. The backend alone resolves a registered code.",
    "matching": "Unicode NFKC, trim, collapse whitespace, casefold; exact match against registered names and aliases only.",
    "unmatched": "Keep raw label/evidence and mark unresolved. Never infer a code from age, symptoms, diagnoses, tests, or hospital name.",
    "ambiguity": "Multiple matching codes require human clarification. Do not select a parent or nearest department as a fallback.",
    "changes": "Human-reviewed additions/alias changes increment catalog_version; affected records require reindexing."
  },
  "directory_sentinels": [
    {
      "code": "unknown0",
      "meaning": "Missing, ambiguous, or unmapped department; not a clinical department."
    },
    {
      "code": "multi000",
      "meaning": "More than one resolved department code; record.json retains the actual codes. Not a clinical department."
    }
  ],
  "non_department_examples": [
    "咽痛",
    "屈光不正",
    "验光单",
    "眼镜处方笺",
    "血液组"
  ],
